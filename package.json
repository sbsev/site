{
  "private": true,
  "name": "studytutors.de",
  "title": "StudyTutors",
  "description": "SvelteKit + Contentful-powered homepage of the German student-run non-profit organization StudyTutors",
  "homepage": "https://studytutors.de",
  "version": "1.0.0",
  "author": "Janosh Riebesell <it@studytutors.de>",
  "repository": "https://github.com/sbsev/site",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "svelte-kit sync && vp build",
    "preview": "vp preview",
    "serve": "svelte-kit sync && vp build && vp preview",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "check": "svelte-check",
    "lint": "vp lint && eslint \"**/*.svelte\"",
    "lint:prod": "vp lint src && eslint \"src/**/*.svelte\"",
    "fmt": "vp fmt 'src/**/*.{ts,js,svelte,css,html}' 'tests/**/*.ts' '*.config.*'",
    "fmt:check": "vp fmt --check 'src/**/*.{ts,js,svelte,css,html}' 'tests/**/*.ts' '*.config.*'"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/bx": "^1.2.2",
    "@iconify-json/bxs": "^1.2.2",
    "@iconify-json/fa-brands": "^1.2.2",
    "@iconify-json/fa-solid": "^1.2.2",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/grommet-icons": "^1.2.4",
    "@iconify-json/heroicons-solid": "^1.2.1",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/ion": "^1.2.6",
    "@iconify-json/map": "^1.2.2",
    "@iconify-json/octicon": "^1.2.19",
    "@iconify-json/ri": "^1.2.6",
    "@iconify-json/simple-icons": "^1.2.61",
    "@mapbox/mapbox-gl-geocoder": "5.1.2",
    "@playwright/test": "1.57.0",
    "@rollup/plugin-yaml": "4.1.2",
    "@sveltejs/adapter-static": "3.0.11",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@types/events": "3.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/mapbox-gl": "3.4.1",
    "@types/mapbox__mapbox-gl-geocoder": "5.1.0",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "eslint": "9.39.1",
    "eslint-plugin-svelte": "3.13.1",
    "js-yaml": "4.1.1",
    "mapbox-gl": "3.17.0",
    "marked": "17.0.1",
    "svelte": "5.59.1",
    "svelte-check": "4.3.4",
    "svelte-eslint-parser": "1.4.1",
    "svelte-multiselect": "11.3.0",
    "svelte-range-slider-pips": "4.1.0",
    "svelte-toc": "0.6.2",
    "svelte2tsx": "0.7.45",
    "typescript": "5.9.3",
    "unplugin-icons": "^22.5.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vite-plus": "1.8.0"
  },
  "dependencies": {
    "yaml": "^2.8.2"
  },
  "packageManager": "pnpm@10.32.1"
}
