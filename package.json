{
  "private": true,
  "name": "studytutors.de",
  "title": "StudyTutors",
  "description": "SvelteKit + Contentful-powered homepage of the German student-run non-profit organization StudyTutors",
  "homepage": "https://studytutors.de",
  "version": "1.0.0",
  "author": "Janosh Riebesell <it@studytutors.de>",
  "repository": "https://github.com/sbsev/site",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*",
    "#package": "./package.json"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "svelte-kit sync && vp build",
    "preview": "vp preview",
    "serve": "svelte-kit sync && vp build && vp preview",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "check": "svelte-check",
    "lint": "vp lint && eslint \"**/*.svelte\"",
    "lint:prod": "vp lint src && eslint \"src/**/*.svelte\"",
    "fmt": "vp fmt 'src/**/*.{ts,js,svelte,css,html}' 'tests/**/*.ts' '*.config.*'",
    "fmt:check": "vp fmt --check 'src/**/*.{ts,js,svelte,css,html}' 'tests/**/*.ts' '*.config.*'"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/bx": "^1.2.3",
    "@iconify-json/bxs": "^1.2.3",
    "@iconify-json/fa-brands": "^1.2.2",
    "@iconify-json/fa-solid": "^1.2.2",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/grommet-icons": "^1.2.4",
    "@iconify-json/heroicons-solid": "^1.2.1",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/ion": "^1.2.8",
    "@iconify-json/map": "^1.2.3",
    "@iconify-json/octicon": "^1.2.41",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.104",
    "@mapbox/mapbox-gl-geocoder": "5.1.3",
    "@playwright/test": "1.65.1",
    "@rollup/plugin-yaml": "5.0.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@types/events": "3.0.3",
    "@types/mapbox__mapbox-gl-geocoder": "5.1.2",
    "@typescript-eslint/eslint-plugin": "8.74.0",
    "@typescript-eslint/parser": "8.74.0",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "js-yaml": "5.5.0",
    "mapbox-gl": "3.35.2",
    "marked": "18.3.0",
    "rollup": "4.68.8",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "svelte-eslint-parser": "1.12.0",
    "svelte-multiselect": "11.8.0",
    "svelte-range-slider-pips": "4.1.1",
    "svelte-toc": "0.7.0",
    "typescript": "6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vite-plus": "1.8.0"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@10.32.1"
}
